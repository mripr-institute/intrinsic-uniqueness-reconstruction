  "statements": [
    {
      "statement_id": "final:F1",
      "status": "main_statement_proved",
      "checked_scope": "Actual normalized exponential quotient, complete normalized Todd tower and its uniqueness over every characteristic-zero field; exact identification of the previously constructed rational recursive tower with that quotient; degree-zero normalization and each positive-degree omission counterexample over every characteristic-zero field. Every scalar twist has the rising-factorial formula, natural twists have the Nat.choose formula, and the twist equality is proved as an actual polynomial identity over Q. The genuine quotient unit, all twists, and normalized uniqueness also hold over every commutative Q-algebra, including algebras with zero divisors. The proof's arbitrary-unit unnormalized family is now constructed by actual recursion and is unique for each marked constant unit over every commutative Q-algebra; distinct unit parameters give distinct series. Arbitrary prescribed normalized positive-degree tower observations also have a unique solution.",
      "lean_theorems": [
        "SigmaFinal.complete_tower_exists_unique",
        "SigmaFinal.degree_zero_tower_is_normalization",
